# ============================================================
# GA4 / Google Search Console 分析ツール 環境変数
# ------------------------------------------------------------
# このファイルをコピーして .env を作り、値を入れてください。
#   cp .env.example .env
# .env は .gitignore 済みです（コミットされません）。
# このファイル（.env.example）には絶対に実値を書かないでください。
# ============================================================

# ---- 必須 --------------------------------------------------

# GA4 のプロパティID（数字のみ。例: 123456789）
# ※ "G-XXXXXXXXXX" は測定IDでありAPIでは使えません。
# 取得場所: GA4 → 管理 → プロパティ設定 → 右上「プロパティID」
GA4_PROPERTY_ID=

# Search Console のプロパティ。登録形式と完全一致させること。
#   ドメインプロパティ    : sc-domain:example.com
#   URLプレフィックス     : https://example.com/   ← 末尾スラッシュまで一致必須
SEARCH_CONSOLE_SITE_URL=

# ---- 認証（どちらか一方） ----------------------------------

# 【推奨・既定】ユーザー認証（ADC）を使う場合はどちらも空のままでOK。
#   gcloud auth application-default login --scopes=...
#   gcloud auth application-default set-quota-project <PROJECT_ID>
# で発行した ~/.config/gcloud/application_default_credentials.json が
# 自動的に使われます。

# ADC の割り当てプロジェクト。gcloud で set-quota-project 済みなら不要。
# 明示指定したい場合のみ Google Cloud のプロジェクトIDを入れる。
GOOGLE_CLOUD_PROJECT=

# 【代替】サービスアカウント鍵を使う場合のみ、リポジトリ「外」の絶対パスを指定。
# 例: /Users/you/.config/google-credentials/pass-analytics.json
# リポジトリ内のパスを指定するとスクリプトが起動時に停止します。
GOOGLE_APPLICATION_CREDENTIALS=

# ---- 任意 --------------------------------------------------

# サイトの正規オリジン。Search Console のページURLと GA4 のパスを
# 突き合わせるために使います。未設定なら SEARCH_CONSOLE_SITE_URL から推定。
# 例: https://example.com
SITE_ORIGIN=

# 出力先ディレクトリ（既定: reports）
ANALYTICS_OUTPUT_DIR=

# Search Console のデータ確定待ち日数（既定: 3）
# 直近数日は未確定のため、既定では「今日-3日」を終端にします。
GSC_LAG_DAYS=

# GA4 のデータ確定待ち日数（既定: 1）
GA4_LAG_DAYS=
