{
  "name": "home-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "夫婦2人向けの常時表示型ホームダッシュボード (Cloudflare Workers)",
  "scripts": {
    "dev": "wrangler dev",
    "dev:demo": "wrangler dev --var DEMO_MODE:1 --var DASHBOARD_TOKEN:localdev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --test test/",
    "token": "node scripts/get-refresh-token.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
